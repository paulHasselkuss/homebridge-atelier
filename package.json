{
  "displayName": "Homebridge Atelier (RS232)",
  "name": "homebridge-atelier-rs232",
  "version": "1.0.1",
  "description": "Homebridge plugin allows you to control your Braun Atelier R4 or CC4 receiver",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/paulHasselkuss/homebridge-atelier.git"
  },
  "bugs": {
    "url": "https://github.com/paulHasselkuss/homebridge-atelier/issues"
  },
  "engines": {
    "node": "^18.17 || ^20.16 || ^22 || ^24 || ^26",
    "homebridge": "^1.8 || ^2"
  },
  "main": "dist/index.js",
  "scripts": {
    "lint": "eslint src/**.ts --max-warnings=0",
    "lint:fix": "eslint src/**.ts --fix",
    "watch": "npm run build && npm link && nodemon",
    "build": "rimraf ./dist && tsc",
    "prepublishOnly": "npm run lint && npm run build"
  },
  "keywords": [
    "homebridge-plugin"
  ],
  "dependencies": {
    "mnemonist": "^0.40.6",
    "serialport": "^13.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26",
    "eslint": "^10.13.0",
    "homebridge": "^2.4.0",
    "nodemon": "^3.1.14",
    "rimraf": "^6.1.3",
    "ts-node": "^10.9.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0"
  }
}
